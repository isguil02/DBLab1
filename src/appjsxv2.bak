import React, {
  useState,
  useEffect,
  useMemo
} from "react";

import EquipmentCard from "./components/EquipmentCard.jsx";
import EquipmentForm from "./components/EquipmentForm.jsx";
import {
  getEquipment,
  createEquipment,
  updateEquipment,
  deleteEquipment
} from "./services/equipmentApi.js";

const statuses = ["Available", "Rented", "Maintenance"];

export default function App() {
  //Equipment now comes from MongoDB, not localStorage.
  const [equipment, setEquipment] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  //Preserve existing filters.
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("All");
  const [status, setStatus] = useState("All");

  //Preserve existing form state.
  const [editing, setEditing] = useState(null);
  const [showForm, setShowForm] = useState(false);

  //FSI change
  const [success, setSuccess] = useState("");

  //Convert MongoDB availability into a display status.
  function displayStatus(item) {
    return item.available ? "Available" : "Rented";
  }

  //NEW: Retrieve equipment from Express.
  async function loadEquipment() {
    setLoading(true);
    setError("");

    try {
      const data = await getEquipment();
      setEquipment(data);
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }

  //NEW: Load equipment when the application opens.
  useEffect(() => {
    loadEquipment();
  }, []);

  //Existing category logic.
  const categories = useMemo(() => {
    return [
      "All",
      ...new Set(equipment.map(item => item.category))
    ];
  }, [equipment]);

  //Existing filtering logic, adapted to MongoDB.
  const visible = useMemo(() => {
    return equipment.filter(item => {
      const matchesSearch = item.name
        .toLowerCase()
        .includes(search.toLowerCase());

      const matchesCategory =
        category === "All" ||
        item.category === category;

      const matchesStatus =
        status === "All" ||
        displayStatus(item) === status;

      return matchesSearch &&
        matchesCategory &&
        matchesStatus;
    });
  }, [equipment, search, category, status]);

  //Keep the existing editing interaction.
  function edit(item) {
    setEditing(item);
    setShowForm(true);

    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  }

  async function save(item) {
    if (editing) {
      await updateEquipment(editing._id, item);
      setSuccess("Equipment updated successfully.");
    } else {
      await createEquipment(item);
      setSuccess("Equipment created successfully.");
    }

    setEditing(null);
    setShowForm(false);
    await loadEquipment();
  }

  async function remove(id) {
    const confirmed = window.confirm(
      "Delete this equipment item?"
    );

    if (!confirmed) return;

    try {
      await deleteEquipment(id);
      setSuccess("Equipment deleted successfully.");
      await loadEquipment();
    } catch (err) {
      setError(err.message);
    }
  }

  function cycle() {
    alert("Reservation status will be added Next.");
  }
  const availableCount = equipment.filter(
    item => item.available
  ).length;

  const rentedCount = equipment.length - availableCount;

  return (
    <div className="shell">
      <aside className="sidebar">
        <div className="brand">
          ▣ <span>GearVault</span>
        </div>

        <div className="side-label">WORKSPACE</div>

        <div className="nav active">
          ▦ &nbsp; Inventory
        </div>

        <div className="nav disabled">
          ▤ &nbsp; Rentals
          <small>Coming Friday</small>
        </div>

        <div className="nav disabled">
          ♙ &nbsp; Customers
          <small>Coming soon</small>
        </div>

        <div className="nav disabled">
          ⚙ &nbsp; Settings
        </div>

        <div className="sidebar-note">
          FULL-STACK MODE
          <br />
          <span>
            React + Express
            <br />
            MongoDB Persistence
          </span>
        </div>
      </aside>

      <main>
        <header>
          <div>
            <div className="eyebrow">
              EQUIPMENT MANAGEMENT
            </div>
            <h1>Inventory overview</h1>
            <p>
              Manage your rental equipment in one place.
            </p>
          </div>

          <button
            className="primary"
            onClick={() => {
              setEditing(null);
              setShowForm(value => !value);
            }}
          >
            + Add equipment
          </button>
        </header>

        <div className="notice">
          Full-stack mode: Equipment is retrieved
          from MongoDB through the Express API.
          {success && (
            <p role="status" className="notice">
              {success}
            </p>
          )}
        </div>
        <section className="stats">
          <div>
            <span>Total assets</span>
            <strong>{equipment.length}</strong>
          </div>
          <div>
            <span>Available</span>
            <strong>{availableCount}</strong>
          </div>
          <div>
            <span>Currently rented</span>
            <strong>{rentedCount}</strong>
          </div>
          <div>
            <span>Maintenance</span>
            <strong>0</strong>
          </div>
        </section>
        {showForm && (
          <EquipmentForm
            editing={editing}
            onSave={save}
            onCancel={() => {
              setEditing(null);
              setShowForm(false);
            }}
          />
        )}

        <section className="inventory">
          <div className="section-head">
            <div>
              <h2>Equipment catalog</h2>
              <p>
                {visible.length} of {equipment.length} items
              </p>
            </div>
            <button
              className="ghost"
              onClick={loadEquipment}
            >
              Refresh equipment
            </button>
          </div>
          <div className="filters">
            <input
              aria-label="Search equipment"
              placeholder="Search equipment..."
              value={search}
              onChange={event =>
                setSearch(event.target.value)
              }
            />
            <select
              aria-label="Filter category"
              value={category}
              onChange={event =>
                setCategory(event.target.value)
              }
            >
              {categories.map(value => (
                <option key={value}>{value}</option>
              ))}
            </select>
            <select
              aria-label="Filter status"
              value={status}
              onChange={event =>
                setStatus(event.target.value)
              }
            >
              {["All", ...statuses].map(value => (
                <option key={value}>{value}</option>
              ))}
            </select>
          </div>
          {loading && <p>Loading equipment...</p>}

          {error && (
            <div role="alert">
              <p>Error: {error}</p>
              <button onClick={loadEquipment}>
                Try again
              </button>
            </div>
          )}

          {!loading && !error && (
            <>
              <div className="cards">
                {visible.map(item => (
                  <EquipmentCard
                    key={item._id}
                    item={{
                      ...item,
                      id: item._id,
                      status: displayStatus(item),
                      description: item.notes || ""
                    }}
                    onEdit={edit}
                    onDelete={remove}
                    onStatus={cycle}
                  />
                ))}
              </div>

              {visible.length === 0 && (
                <div className="empty">
                  No matching equipment found.
                  Try different filters.
                </div>
              )}
            </>
          )}
        </section>

        <footer>
          GearVault · Full Stack Development · Full Integration Version 
        </footer>
      </main>
    </div>
  );
}
